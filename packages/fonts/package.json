{
  "type"              : "module",
  "name"              : "@obvia/fonts",
  "description"       : "Obvia Fonts - A newly designed font family crafted for designers, developers, and storytellers who demand clarity and impact",
  "keywords"          : ["obvia","obvia mono","obvia sans","obvia pixel","typeface","fonts","obvia fonts","webfont","open-type","true-type","typography"],
  "license"           : "SIL OPEN FONT LICENSE",
  "homepage"          : "https://obvia.studio/fonts",
  "version"           : "0.4.3",

  "author"            : {
    "name"      : "Selçuk Çukur",
    "email"     : "hello@selcukcukur.me",
    "url"       : "https://selcukcukur.me"
  },

  "bugs"              : {
    "email"   : "security@selcukcukur.me",
    "url"     : "https://github.com/obvialabs/fonts/issues"
  },

  "main"              : "./dist/index.js",
  "module"            : "./dist/index.js",
  "types"             : "./dist/index.d.ts",

  "scripts"           : {
    "prepare"         : "cp ../../OFL.txt license.md",
    "version"         : "changeset version",
    "release"         : "changeset publish"
  },

  "devDependencies"   : {
    "@changesets/cli" : "^2.29.8",
    "typescript"      : "^5.9.3"
  },
  "peerDependencies"  : {
    "next"        : ">=13.2.0"
  },

  "exports"           : {
    "."         : {
      "types"   : "./dist/index.d.ts",
      "default" : "./dist/index.js"
    }
  },
  "files"             : ["dist"],

  "publishConfig"     : {
    "access"  : "public"
  },
  "publisher"         : {
    "type" : "github",
    "user" : "obvialabs",
    "repo" : "fonts"
  },
  "repository"        : {
    "type"      : "git",
    "url"       : "git+https://github.com/obvialabs/fonts.git",
    "directory" : "packages/fonts"
  },

  "packageManager"    : "pnpm@10.32.1"
