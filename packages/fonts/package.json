{
  "type"              : "module",
  "name"              : "@obvia/fonts",
  "description"       : "Obvia is a new font family for custom typography families designed for unique and cohesive branding",
  "keywords"          : ["obvia","obvia mono","obvia sans","obvia pixel","typeface","fonts","obvia fonts","webfont","open-type","true-type","typography"],
  "license"           : "SIL OPEN FONT LICENSE",
  "homepage"          : "https://obvia.studio/fonts",
  "version"           : "0.0.8",

  "author"            : {
    "name"      : "Selçuk Çukur",
    "email"     : "hello@selcukcukur.me",
    "url"       : "https://selcukcukur.me"
  },

  "bugs"              : {
    "email"   : "security@selcukcukur.me",
    "url"     : "https://github.com/obvialabs/fonts/issues"
  },

  "main"              : "./dist/index.js",
  "module"            : "./dist/index.js",
  "types"             : "./dist/index.d.ts",

  "scripts"           : {
    "prebuild"    : "robocopy src\\\\fonts dist\\\\fonts /E",
    "build"       : "tsc"
  },

  "devDependencies"   : {
    "typescript"  : "^5.9.3"
  },
  "peerDependencies"  : {
    "react"       : ">=18.0.0",
    "vue"         : ">=3.0.0",
    "nuxt"        : ">=4.0.0",
    "next"        : ">=13.2.0"
  },

  "exports"           : {
    "."         : {
      "types"   : "./dist/index.d.ts",
      "default" : "./dist/index.js"
    },
    "./react"   : {
      "types"   : "./dist/react.d.ts",
      "default" : "./dist/react.js"
    },
    "./vanilla"    : {
      "types"   : "./dist/vanilla.d.ts",
      "default" : "./dist/vanilla.js"
    },
    "./vue"     : {
      "types"   : "./dist/vue.d.ts",
      "default" : "./dist/vue.js"
    },
    "./nuxt"    : {
      "types"   : "./dist/nuxt.d.ts",
      "default" : "./dist/nuxt.js"
    }
  },
  "files"             : ["dist", "fonts"],

  "publishConfig"     : {
    "access"  : "public"
  },
  "publisher"         : {
    "type" : "github",
    "user" : "obvialabs",
    "repo" : "fonts"
  },
  "repository"        : {
    "type"      : "git",
    "url"       : "git+https://github.com/obvialabs/fonts.git",
    "directory" : "packages/fonts"
  },

  "packageManager"    : "pnpm@10.32.1"
}
